# Kopieren nach apps/server/.env und ausfüllen. Die Datei .env wird nicht eingecheckt.

# Datenbank (passt zu docker-compose.yml im Wurzelverzeichnis)
DATABASE_URL=postgres://value:value@localhost:5432/value

PORT=8787
# Erlaubte Web-Ursprünge, durch Komma getrennt. Leer = alle (nur für die Entwicklung).
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=300
# Auf "true" setzen, wenn der Server hinter einem Lastverteiler oder CDN läuft.
TRUST_PROXY=false

# Schlüssel von https://www.pokemonpricetracker.com/api-keys
# Gehört nur hierher. Nie in die App, nie ins Repository.
PPT_API_KEY=

# "api" = Einzelabrufe (Free- und API-Tarif). "export" = Tages-Export (Business-Tarif).
SYNC_MODE=api
# Im Modus "api": Sets, die abgeglichen werden, als Namen wie in der Quelle, durch Komma getrennt.
SYNC_SETS=Celebrations
SYNC_LANGUAGE=english
# Der Free-Tarif hat 100 Credits am Tag. Ein Set kostet einen Credit je Karte.
SYNC_MAX_CREDITS_PER_RUN=90
# Gegradete eBay-Preise (PSA, CGC, BGS) mitladen. Für die Kartenansicht "PSA" und "CGC".
SYNC_INCLUDE_GRADED=false
# Populationsbericht für so viele Karten je Lauf (2 Credits je Karte, nur Business-Tarif). 0 = aus.
SYNC_POPULATION_MAX_CARDS=0
# Preisverlauf der letzten Tage beim ersten Abgleich mitladen (1 Credit mehr je Karte, Free-Tarif höchstens 3). 0 = aus.
SYNC_HISTORY_DAYS=0

# Scanner: gleichzeitige Texterkennungen je Prozess (je eine belegt einen Kern) und Scans je Minute und Absender.
SCAN_OCR_WORKERS=2
SCAN_RATE_PER_MINUTE=30

# Katalog von TCGdex (npm run catalog): Sprachen, gleichzeitige Abrufe, Abstand
# für den erneuten Abgleich bekannter Sets, Demo-Sets entfernen. Mit Katalog von
# TCGdex liefert Pokemon Price Tracker nur noch Preise (SYNC_SETS wie oben).
CATALOG_LANGUAGES=en,de,ja
CATALOG_CONCURRENCY=8
CATALOG_REFRESH_DAYS=30
CATALOG_REMOVE_DEMO=true
