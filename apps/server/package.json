{
  "name": "@value/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "sync": "tsx --env-file-if-exists=.env src/sync/cli.ts",
    "ppt:probe": "tsx --env-file-if-exists=.env src/sync/probe.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/db/seed-demo.ts",
    "seed:load": "tsx --env-file-if-exists=.env src/db/seed-load.ts",
    "test": "vitest run",
    "loadtest": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@value/api-types": "*",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0",
    "autocannon": "^8.0.0"
  }
}
