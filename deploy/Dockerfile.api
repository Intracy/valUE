# API-Server von valUE. Startet mit Migration, auf Wunsch Demo-Daten, dann den Server.
FROM node:22-bookworm-slim

WORKDIR /app
# Erst nur die Paketlisten: Solange sie gleich bleiben, nutzt Docker die installierten Pakete wieder.
COPY package.json package-lock.json ./
COPY packages/api-types/package.json packages/api-types/
COPY apps/server/package.json apps/server/
COPY apps/mobile/package.json apps/mobile/
RUN npm ci -w @value/server -w @value/api-types --no-audit --no-fund

COPY packages/api-types packages/api-types
COPY apps/server apps/server

WORKDIR /app/apps/server
ENV HOST=0.0.0.0 \
    PORT=8787 \
    NODE_ENV=production
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
  CMD node -e "fetch('http://127.0.0.1:8787/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "npx tsx src/db/migrate-cli.ts && if [ \"$SEED_DEMO\" = \"true\" ]; then npx tsx src/db/seed-demo.ts; fi && exec npx tsx src/server.ts"]
