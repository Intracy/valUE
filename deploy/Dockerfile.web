# Web-Fassung der App (Expo), ausgeliefert von nginx. nginx reicht /v1 an den
# API-Server weiter: App und Server haben dieselbe Adresse, kein CORS nötig.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/api-types/package.json packages/api-types/
COPY apps/server/package.json apps/server/
COPY apps/mobile/package.json apps/mobile/
RUN npm ci -w @value/mobile -w @value/api-types --no-audit --no-fund
COPY packages/api-types packages/api-types
COPY apps/mobile apps/mobile
WORKDIR /app/apps/mobile
# "/" heißt: dieselbe Adresse wie die Seite. Die App ruft dann /v1/... auf.
ENV EXPO_PUBLIC_API_URL=/
RUN npx expo export --platform web --output-dir /out

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /out /usr/share/nginx/html
EXPOSE 80
